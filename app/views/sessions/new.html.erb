<div class="glass-container" style="max-width: 350px; width: 100%; margin: 0 auto; text-align: center;">
  <div class="glass-title">Sistema Usuarios</div>
  <div class="glass-subtitle">Acceso al sistema</div>

  <div id="error-message" style="display: none; background: rgba(225, 29, 72, 0.1); border: 1px solid var(--danger); color: var(--danger); padding: 12px; border-radius: 12px; margin-bottom: 20px; font-size: 14px;"></div>

  <form id="login-form">
    <input type="text" id="strNombreUsuario" class="glass-input" placeholder="Usuario" required style="margin-bottom: 15px;">
    <input type="password" id="strPwd" class="glass-input" placeholder="Contraseña" required style="margin-bottom: 25px;">
    
    <div style="display: flex; justify-content: center; margin-bottom: 25px;">
      <div class="g-recaptcha" data-sitekey="6LezwUQsAAAAAMpHyysHHMXLH-3_zu9JZcmCcW48"></div>
    </div>

    <button type="submit" class="glass-btn" style="width: 100%;">Ingresar</button>
  </form>
</div>

<script src="https://www.google.com/recaptcha/api.js" async defer></script>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('login-form');
    const errorDiv = document.getElementById('error-message');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const recaptchaResponse = grecaptcha.getResponse();
      
      if (recaptchaResponse.length === 0) {
        errorDiv.textContent = 'Por favor, verifica que no eres un robot.';
        errorDiv.style.display = 'block';
        return;
      }

      const strNombreUsuario = document.getElementById('strNombreUsuario').value;
      const strPwd = document.getElementById('strPwd').value;

      try {
        const response = await fetch('/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ 
            strNombreUsuario, 
            strPwd,
            recaptcha_response: recaptchaResponse 
          })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          localStorage.setItem('jwt_token', data.token);
          window.location.href = data.redirect_url;
        } else {
          errorDiv.textContent = data.message;
          errorDiv.style.display = 'block';
          grecaptcha.reset(); 
        }
      } catch (error) {
        errorDiv.textContent = 'Error de conexión con el servidor.';
        errorDiv.style.display = 'block';
        grecaptcha.reset();
      }
    });
  });
</script>