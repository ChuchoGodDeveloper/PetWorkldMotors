<div class="glass-container" style="width: 100%; max-width: 800px; margin: 0 auto;">
  <div style="font-size: 13px; color: var(--text-light); margin-bottom: 25px;">
    <a href="/principal" style="color: var(--accent); text-decoration: none; font-weight: 600;">Inicio</a> > Principal 2 > Principal 2.1
  </div>

  <div style="text-align: center; margin-bottom: 40px;">
    <h2 class="glass-title">Módulo Principal 2.1</h2>
    <div class="glass-subtitle">Vista Estilo Lista Continua</div>
    <% if tiene_permiso?('Principal 2.1', :bitAgregar) %>
      <button class="glass-btn" style="border-radius: 30px; padding: 10px 30px;" onclick="agregarDato_2_1('lista-2-1')">+ Nuevo Elemento</button>
    <% end %>
  </div>

  <div id="lista-2-1" style="display: flex; flex-direction: column; gap: 15px;">
    <div class="item-wrapper" style="display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.5); padding: 15px 25px; border-radius: 12px; border: 1px solid var(--glass-border);">
      <div style="display: flex; align-items: center; gap: 15px;">
        <i class="fas fa-circle" style="color: var(--accent); font-size: 10px;"></i>
        <span class="dato-texto" style="font-weight: 600; font-size: 16px; color: var(--text-dark);">Vehículo de muestra</span>
      </div>
      <div style="display: flex; gap: 10px;">
        <% if tiene_permiso?('Principal 2.1', :bitDetalle) %>
          <button class="glass-btn glass-btn-outline" style="padding: 8px 15px; border-radius: 8px;" onclick="verDetalle(this)"><i class="fas fa-eye"></i></button>
        <% end %>
        <% if tiene_permiso?('Principal 2.1', :bitEditar) %>
          <button class="glass-btn glass-btn-outline" style="padding: 8px 15px; border-radius: 8px;" onclick="editarDato(this)"><i class="fas fa-pen"></i></button>
        <% end %>
        <% if tiene_permiso?('Principal 2.1', :bitEliminar) %>
          <button class="glass-btn glass-btn-danger" style="padding: 8px 15px; border-radius: 8px;" onclick="eliminarDato(this)"><i class="fas fa-trash"></i></button>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  window.agregarDato_2_1 = function(contenedorId) {
    const dato = prompt("Ingresa el elemento de la lista:");
    if (!dato) return;

    const lista = document.getElementById(contenedorId);
    const fila = document.createElement('div');
    fila.className = 'item-wrapper';
    fila.style.cssText = "display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.5); padding: 15px 25px; border-radius: 12px; border: 1px solid var(--glass-border);";

    let botonesHTML = '<div style="display: flex; gap: 10px;">';
    <% if tiene_permiso?('Principal 2.1', :bitDetalle) %>
      botonesHTML += '<button class="glass-btn glass-btn-outline" style="padding: 8px 15px; border-radius: 8px;" onclick="verDetalle(this)"><i class="fas fa-eye"></i></button>';
    <% end %>
    <% if tiene_permiso?('Principal 2.1', :bitEditar) %>
      botonesHTML += '<button class="glass-btn glass-btn-outline" style="padding: 8px 15px; border-radius: 8px;" onclick="editarDato(this)"><i class="fas fa-pen"></i></button>';
    <% end %>
    <% if tiene_permiso?('Principal 2.1', :bitEliminar) %>
      botonesHTML += '<button class="glass-btn glass-btn-danger" style="padding: 8px 15px; border-radius: 8px;" onclick="eliminarDato(this)"><i class="fas fa-trash"></i></button>';
    <% end %>
    botonesHTML += '</div>';

    fila.innerHTML = `
      <div style="display: flex; align-items: center; gap: 15px;">
        <i class="fas fa-circle" style="color: var(--accent); font-size: 10px;"></i>
        <span class="dato-texto" style="font-weight: 600; font-size: 16px; color: var(--text-dark);">${dato}</span>
      </div>
      ${botonesHTML}
    `;
    lista.appendChild(fila);
  };
</script>