<div class="glass-container" style="width: 100%; max-width: 1000px; margin: 0 auto; background: transparent; border: none; box-shadow: none; padding: 0;">
  <div style="background: var(--glass-surface); backdrop-filter: blur(20px); border: 1px solid var(--glass-border); border-radius: 20px; padding: 40px; margin-bottom: 30px;">
    <div style="font-size: 13px; color: var(--text-light); margin-bottom: 25px;">
      <a href="/principal" style="color: var(--accent); text-decoration: none; font-weight: 600;">Inicio</a> > Principal 1 > Principal 1.2
    </div>

    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 20px;">
      <div>
        <h2 class="glass-title" style="margin: 0;">Módulo Principal 1.2</h2>
        <div class="glass-subtitle" style="margin: 5px 0 0 0;">Vista Estilo Tarjetas (Grid)</div>
      </div>
      <% if tiene_permiso?('Principal 1.2', :bitAgregar) %>
        <button class="glass-btn" onclick="agregarDato_1_2('grid-1-2')"><i class="fas fa-plus"></i> Nueva Tarjeta</button>
      <% end %>
    </div>
  </div>

  <div id="grid-1-2" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px;">
    <div class="item-wrapper" style="background: rgba(255,255,255,0.4); border: 1px solid var(--glass-border); border-radius: 16px; padding: 25px; transition: transform 0.2s;">
      <div style="width: 40px; height: 40px; background: var(--accent); color: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 15px;">
        <i class="fas fa-cube"></i>
      </div>
      <h3 class="dato-texto" style="margin: 0 0 15px 0; color: var(--text-dark); font-size: 18px;">Vehículo de muestra</h3>
      
      <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <% if tiene_permiso?('Principal 1.2', :bitDetalle) %>
          <button class="glass-btn glass-btn-outline" style="flex: 1; padding: 8px;" onclick="verDetalle(this)">Ver</button>
        <% end %>
        <% if tiene_permiso?('Principal 1.2', :bitEditar) %>
          <button class="glass-btn glass-btn-outline" style="flex: 1; padding: 8px;" onclick="editarDato(this)">Editar</button>
        <% end %>
        <% if tiene_permiso?('Principal 1.2', :bitEliminar) %>
          <button class="glass-btn glass-btn-danger" style="width: 100%; padding: 8px; margin-top: 5px;" onclick="eliminarDato(this)">Eliminar</button>
        <% end %>
      </div>
    </div>
  </div>
</div>

<script>
  window.agregarDato_1_2 = function(contenedorId) {
    const dato = prompt("Ingresa el título de la tarjeta:");
    if (!dato) return;

    const grid = document.getElementById(contenedorId);
    const card = document.createElement('div');
    card.className = 'item-wrapper';
    card.style.cssText = "background: rgba(255,255,255,0.4); border: 1px solid var(--glass-border); border-radius: 16px; padding: 25px;";

    let botonesHTML = '<div style="display: flex; gap: 10px; flex-wrap: wrap;">';
    <% if tiene_permiso?('Principal 1.2', :bitDetalle) %>
      botonesHTML += '<button class="glass-btn glass-btn-outline" style="flex: 1; padding: 8px;" onclick="verDetalle(this)">Ver</button>';
    <% end %>
    <% if tiene_permiso?('Principal 1.2', :bitEditar) %>
      botonesHTML += '<button class="glass-btn glass-btn-outline" style="flex: 1; padding: 8px;" onclick="editarDato(this)">Editar</button>';
    <% end %>
    <% if tiene_permiso?('Principal 1.2', :bitEliminar) %>
      botonesHTML += '<button class="glass-btn glass-btn-danger" style="width: 100%; padding: 8px; margin-top: 5px;" onclick="eliminarDato(this)">Eliminar</button>';
    <% end %>
    botonesHTML += '</div>';

    card.innerHTML = `
      <div style="width: 40px; height: 40px; background: var(--accent); color: white; border-radius: 10px; display: flex; align-items: center; justify-content: center; margin-bottom: 15px;"><i class="fas fa-star"></i></div>
      <h3 class="dato-texto" style="margin: 0 0 15px 0; color: var(--text-dark); font-size: 18px;">${dato}</h3>
      ${botonesHTML}
    `;
    grid.appendChild(card);
  };
</script>