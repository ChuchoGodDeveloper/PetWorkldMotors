<div class="neo-container" style="width: 800px; max-width: 90%;">
  <div style="text-align: left; font-size: 12px; color: #888; margin-bottom: 20px;">
    <a href="/principal" style="color: #888; text-decoration: none;">Inicio</a> > Principal 1 > Principal 1.1
  </div>

  <div class="neo-title">Módulo Principal 1.1</div>
  <div class="neo-subtitle">Pantalla interactiva de demostración</div>

  <div style="margin-bottom: 20px; display: flex; gap: 10px; justify-content: flex-start;">
    <% if tiene_permiso?('Principal 1.1', :bitAgregar) %>
      <button class="neo-button" style="width: auto; padding: 10px 20px;" onclick="agregarDato_1_1('tabla-estatica-1-1')">Agregar Nuevo</button>
    <% end %>
  </div>

  <table style="width: 100%; border-collapse: collapse; text-align: left; color: #4a4a4a;">
    <thead>
      <tr style="border-bottom: 2px solid #c9d0dabc;">
        <th style="padding: 10px;">Datos de Prueba</th>
        <th style="padding: 10px; text-align: center;">Acciones</th>
      </tr>
    </thead>
    <tbody id="tabla-estatica-1-1">
      <tr style="border-bottom: 1px solid #c9d0dabc;">
        <td style="padding: 10px;" class="dato-texto">Vehículo de muestra</td>
        <td style="padding: 10px; text-align: center;">
          <% if tiene_permiso?('Principal 1.1', :bitDetalle) %>
            <button class="neo-button" style="padding: 5px 10px; font-size: 12px; width: auto;" onclick="verDetalle(this)">Detalle</button>
          <% end %>
          <% if tiene_permiso?('Principal 1.1', :bitEditar) %>
            <button class="neo-button" style="padding: 5px 10px; font-size: 12px; width: auto;" onclick="editarDato(this)">Editar</button>
          <% end %>
          <% if tiene_permiso?('Principal 1.1', :bitEliminar) %>
            <button class="neo-button" style="padding: 5px 10px; font-size: 12px; width: auto; color: #ff4757;" onclick="eliminarDato(this)">Eliminar</button>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>
</div>

<script>
  window.agregarDato_1_1 = function(tablaId) {
    const dato = prompt("Ingresa el nombre del nuevo registro:");
    if (!dato) return;

    const tbody = document.getElementById(tablaId);
    const tr = document.createElement('tr');
    tr.style.borderBottom = "1px solid #c9d0dabc";

    let botonesHTML = '';
    <% if tiene_permiso?('Principal 1.1', :bitDetalle) %>
      botonesHTML += '<button class="neo-button" style="padding: 5px 10px; font-size: 12px; width: auto;" onclick="verDetalle(this)">Detalle</button> ';
    <% end %>
    <% if tiene_permiso?('Principal 1.1', :bitEditar) %>
      botonesHTML += '<button class="neo-button" style="padding: 5px 10px; font-size: 12px; width: auto;" onclick="editarDato(this)">Editar</button> ';
    <% end %>
    <% if tiene_permiso?('Principal 1.1', :bitEliminar) %>
      botonesHTML += '<button class="neo-button" style="padding: 5px 10px; font-size: 12px; width: auto; color: #ff4757;" onclick="eliminarDato(this)">Eliminar</button>';
    <% end %>

    tr.innerHTML = `<td style="padding: 10px;" class="dato-texto">${dato}</td><td style="padding: 10px; text-align: center;">${botonesHTML}</td>`;
    tbody.appendChild(tr);
  };

  // Métodos genéricos para interacción visual (sin afectar base de datos)
  window.editarDato = window.editarDato || function(btn) {
    const td = btn.closest('tr').querySelector('.dato-texto');
    const nuevoDato = prompt("Edita el dato:", td.innerText);
    if (nuevoDato) td.innerText = nuevoDato;
  };

  window.eliminarDato = window.eliminarDato || function(btn) {
    if (confirm("¿Estás seguro de eliminar este registro de prueba?")) btn.closest('tr').remove();
  };

  window.verDetalle = window.verDetalle || function(btn) {
    const td = btn.closest('tr').querySelector('.dato-texto');
    alert("INFORMACIÓN DEL REGISTRO\n\nNombre: " + td.innerText + "\nEstado: Activo\nFecha simulada: " + new Date().toLocaleDateString());
  };
</script>