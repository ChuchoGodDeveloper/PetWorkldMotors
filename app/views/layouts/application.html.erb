<!DOCTYPE html>
<html>
  <head>
    <title>Sistema Usuarios</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  </head>
  <body>
    <% unless request.path == '/login' || request.path == '/' %>
      <header class="glass-topbar" id="topbar-menu">
        <div class="glass-title" style="margin: 0; white-space: nowrap; font-size: 22px;">Sistema Usuarios</div>
        
        <div id="dinamic-nav"></div>
        
        <button id="btn-logout" class="glass-btn glass-btn-danger" style="padding: 10px 20px; margin-left: 20px;">Cerrar Sesión</button>
      </header>
    <% end %>

    <div class="<%= 'glass-content' unless request.path == '/login' || request.path == '/' %>" 
         style="<%= 'width: 100%; height: 100vh; display: flex; justify-content: center; align-items: center;' if request.path == '/login' || request.path == '/' %>">
      <%= yield %>
    </div>

    <% unless request.path == '/login' || request.path == '/' %>
    <script>
      document.addEventListener('DOMContentLoaded', async () => {
        const token = localStorage.getItem('jwt_token');
        if (!token) {
          window.location.replace('/login');
          return;
        }

        const nav = document.getElementById('dinamic-nav');
        try {
          const res = await fetch('/menu_dinamico', { headers: { 'Authorization': `Bearer ${token}` } });
          if (!res.ok) throw new Error('No autorizado');

          const menuData = await res.json();
          for (const [padre, datosPadre] of Object.entries(menuData)) {
            
            const wrapper = document.createElement('div');
            wrapper.style.position = 'relative';

            const btn = document.createElement('button');
            btn.className = 'menu-item';
            btn.innerHTML = `<div style="display: flex; align-items: center; gap: 8px;"><i class="${datosPadre.icono}"></i><span>${padre}</span></div><span style="margin-left: 8px; font-size: 0.8rem;">▼</span>`;
            
            const submenu = document.createElement('div');
            submenu.className = 'submenu';

            datosPadre.modulos.forEach(mod => {
              const link = document.createElement('a');
              link.href = mod.url;
              link.innerHTML = `<i class="${mod.icono}" style="width: 20px; text-align: center; margin-right: 8px;"></i><span>${mod.nombre.replace('_', ' ')}</span>`;
              submenu.appendChild(link);
            });

            btn.onclick = (e) => {
              e.stopPropagation();
              document.querySelectorAll('.submenu').forEach(sm => {
                if (sm !== submenu) sm.style.display = 'none';
              });
              const isOculto = submenu.style.display === 'none' || submenu.style.display === '';
              submenu.style.display = isOculto ? 'flex' : 'none';
            };

            wrapper.appendChild(btn);
            wrapper.appendChild(submenu);
            nav.appendChild(wrapper);
          }

          document.addEventListener('click', () => {
            document.querySelectorAll('.submenu').forEach(sm => sm.style.display = 'none');
          });

        } catch (error) {
          console.error(error);
          localStorage.removeItem('jwt_token');
          window.location.replace('/login');
        }

        document.getElementById('btn-logout').addEventListener('click', () => {
          localStorage.removeItem('jwt_token');
          window.location.replace('/login');
        });

        // Eventos de validación omitidos para brevedad (Mantén los mismos que ya tenías)
      });
    </script>
    <% end %>
  </body>
</html>