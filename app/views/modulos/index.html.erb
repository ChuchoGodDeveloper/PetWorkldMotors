<div class="glass-container">
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <h2 class="glass-title" style="margin: 0;">Gestión de Módulos</h2>
    <% if tiene_permiso?('Modulos', :bitAgregar) %>
      <%= link_to 'Nuevo Módulo', new_modulo_path, class: "glass-btn" %>
    <% end %>
  </div>

  <div style="margin-bottom: 30px;">
    <input type="text" id="buscador-input" placeholder="🔍 Buscar módulo..." class="glass-input" style="max-width: 350px; margin: 0;">
  </div>

  <div style="background: rgba(255,255,255,0.3); border-radius: 16px; padding: 20px; overflow-x: auto;">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Nombre del Módulo</th>
          <th style="text-align: center;">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @modulos.each do |modulo| %>
          <tr class="fila-busqueda" data-search="<%= modulo.strNombreModulo.downcase %>">
            <td style="color: var(--text-light);"><%= modulo.id %></td>
            <td style="font-weight: bold;"><%= modulo.strNombreModulo %></td>
            <td style="text-align: center;">
              <div style="display: flex; gap: 10px; justify-content: center;">
                <% if tiene_permiso?('Modulos', :bitEditar) %>
                  <%= link_to 'Editar', edit_modulo_path(modulo), class: "glass-btn glass-btn-outline", style: "padding: 8px 16px;" %>
                <% end %>
                <% if tiene_permiso?('Modulos', :bitEliminar) %>
                  <%= button_to 'Eliminar', modulo_path(modulo), method: :delete, form: { data: { turbo_confirm: '¿Estás seguro?' } }, class: "glass-btn glass-btn-danger", style: "padding: 8px 16px;" %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>