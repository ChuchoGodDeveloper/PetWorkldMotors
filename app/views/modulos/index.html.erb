<div class="neo-container" style="width: 800px; max-width: 90%;">
  <div style="text-align: left; font-size: 12px; color: #888; margin-bottom: 20px;">
    <a href="/principal" style="color: #888; text-decoration: none;">Inicio</a> > Seguridad > Módulos
  </div>

  <div class="neo-title">Módulo Módulo</div>

  <form id="form-modulo" style="margin-bottom: 30px; display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
    <input type="hidden" id="modulo-id">
    <input type="text" id="strNombreModulo" class="neo-input" style="margin-bottom: 0; flex: 1;" placeholder="Nombre del Módulo" required>

    <button type="submit" class="neo-button" style="width: auto; padding: 10px 20px;" id="btn-guardar">Guardar</button>
    <button type="button" class="neo-button" style="width: auto; padding: 10px 20px; display: none;" id="btn-cancelar">Cancelar</button>
  </form>

  <table style="width: 100%; border-collapse: collapse; text-align: left; color: #4a4a4a;">
    <thead>
      <tr style="border-bottom: 2px solid #c9d0dabc;">
        <th style="padding: 10px;">ID</th>
        <th style="padding: 10px;">Nombre del Módulo</th>
        <th style="padding: 10px; text-align: center;">Acciones</th>
      </tr>
    </thead>
    <tbody id="tabla-modulos">
      </tbody>
  </table>

  <div id="paginacion" style="margin-top: 20px; display: flex; justify-content: center; gap: 10px;">
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const token = localStorage.getItem('jwt_token');
  if (!token) window.location.replace('/login');

  const tabla = document.getElementById('tabla-modulos');
  const form = document.getElementById('form-modulo');
  const paginacion = document.getElementById('paginacion');
  const btnCancelar = document.getElementById('btn-cancelar');
  const inputId = document.getElementById('modulo-id');
  const inputNombre = document.getElementById('strNombreModulo');

  let currentPage = 1;

  const cargarModulos = async (page = 1) => {
    try {
      const res = await fetch(`/modulos.json?page=${page}`);
      const json = await res.json();
      
      tabla.innerHTML = '';
      json.data.forEach(modulo => {
        const tr = document.createElement('tr');
        tr.style.borderBottom = '1px solid #c9d0dabc';
        tr.innerHTML = `
          <td style="padding: 10px;">${modulo.id}</td>
          <td style="padding: 10px;">${modulo.strNombreModulo}</td>
          <td style="padding: 10px; text-align: center;">
            <button class="neo-button" style="padding: 5px 10px; font-size: 12px; width: auto;" onclick="editarModulo(${modulo.id})">Editar</button>
            <button class="neo-button" style="padding: 5px 10px; font-size: 12px; width: auto; color: #ff4757;" onclick="eliminarModulo(${modulo.id})">Eliminar</button>
          </td>
        `;
        tabla.appendChild(tr);
      });

      renderizarPaginacion(json.meta.current_page, json.meta.total_pages);
    } catch (error) {
      console.error('Error:', error);
    }
  };

  const renderizarPaginacion = (current, total) => {
    paginacion.innerHTML = '';
    for (let i = 1; i <= total; i++) {
      const btn = document.createElement('button');
      btn.textContent = i;
      btn.className = 'neo-button';
      btn.style.width = '40px';
      btn.style.padding = '10px';
      if (i === current) btn.style.boxShadow = 'inset 6px 6px 10px 0 rgba(163, 177, 198, 0.7), inset -6px -6px 10px 0 rgba(255, 255, 255, 0.8)';
      btn.onclick = () => { currentPage = i; cargarModulos(currentPage); };
      paginacion.appendChild(btn);
    }
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = inputId.value;
    const url = id ? `/modulos/${id}.json` : '/modulos.json';
    const method = id ? 'PUT' : 'POST';

    const payload = {
      modulo: {
        strNombreModulo: inputNombre.value
      }
    };

    try {
      const res = await fetch(url, {
        method: method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        limpiarFormulario();
        cargarModulos(currentPage);
      } else {
        alert('Error al guardar. Verifica que el nombre no esté duplicado.');
      }
    } catch (error) {
      console.error('Error:', error);
    }
  });

  window.editarModulo = async (id) => {
    try {
      const res = await fetch(`/modulos/${id}.json`);
      const modulo = await res.json();
      inputId.value = modulo.id;
      inputNombre.value = modulo.strNombreModulo;
      btnCancelar.style.display = 'inline-block';
    } catch (error) {
      console.error('Error:', error);
    }
  };

  window.eliminarModulo = async (id) => {
    if (!confirm('¿Seguro que deseas eliminar este módulo?')) return;
    try {
      await fetch(`/modulos/${id}.json`, { method: 'DELETE' });
      cargarModulos(currentPage);
    } catch (error) {
      console.error('Error:', error);
    }
  };

  const limpiarFormulario = () => {
    inputId.value = '';
    inputNombre.value = '';
    btnCancelar.style.display = 'none';
  };

  btnCancelar.addEventListener('click', limpiarFormulario);

  cargarModulos();
});
</script>