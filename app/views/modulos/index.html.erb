<div class="neo-container">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <h2 class="neo-title" style="margin: 0;">Gestión de Módulos</h2>
    <%= link_to 'Nuevo Módulo', new_modulo_path, class: "neo-button", style: "width: auto; padding: 10px 20px; text-decoration: none;" %>
  </div>

  <div style="margin-bottom: 30px; text-align: left;">
    <label class="neo-subtitle" style="display: block; margin-bottom: 10px; font-weight: bold;">BUSCAR POR NOMBRE</label>
    <%= form_with url: modulos_path, method: :get, local: true, style: "display: flex; gap: 15px;" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "Nombre del módulo...", class: "neo-input", style: "margin: 0; flex-grow: 1;" %>
      <%= f.submit "Buscar", class: "neo-button", style: "width: auto; padding: 10px 30px; margin: 0;" %>
    <% end %>
  </div>

  <table style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead>
      <tr style="border-bottom: 2px solid rgba(163,177,198,0.6);">
        <th style="padding: 15px 10px; color: #333;">#</th>
        <th style="padding: 15px 10px; color: #333;">NOMBRE DEL MÓDULO</th>
        <th style="padding: 15px 10px; text-align: center; color: #333;">ACCIONES</th>
      </tr>
    </thead>
    <tbody>
      <% @modulos.each do |modulo| %>
        <tr style="border-bottom: 1px solid rgba(163,177,198,0.3);">
          <td style="padding: 15px 10px; color: #666;"><%= modulo.id %></td>
          <td style="padding: 15px 10px; font-weight: bold; color: #4a4a4a;"><%= modulo.strNombreModulo %></td>
          <td style="padding: 15px 10px; text-align: center;">
            <div style="display: flex; gap: 10px; justify-content: center;">
              <%= link_to 'Editar', edit_modulo_path(modulo), class: "neo-button", style: "width: auto; padding: 8px 15px; text-decoration: none;" %>
              <%= button_to 'Eliminar', modulo_path(modulo), method: :delete, form: { data: { turbo_confirm: '¿Estás seguro?' } }, class: "neo-button", style: "width: auto; padding: 8px 15px; color: #ff4757;" %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div style="margin-top: 20px;">
    <%= paginate @modulos if defined?(paginate) %>
  </div>
</div>