<div class="glass-container" style="max-width: 800px; margin: 0 auto;">
  <h2 class="glass-title" style="text-align: center; margin-bottom: 40px;">
    <%= @modulo.new_record? ? 'Nuevo Módulo' : 'Editar Módulo' %>
  </h2>

  <%= form_with(model: @modulo, local: true) do |form| %>
    
    <% if @modulo.errors.any? %>
      <div style="background: rgba(225, 29, 72, 0.1); border: 1px solid var(--danger); color: var(--danger); padding: 15px; border-radius: 12px; margin-bottom: 20px;">
        <ul style="margin: 0; padding-left: 20px;">
          <% @modulo.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="background: rgba(255,255,255,0.3); border-radius: 16px; padding: 25px; margin-bottom: 25px;">
      <h3 style="margin-top: 0; color: var(--text-dark);">1. Datos del Módulo</h3>
      <div style="display: flex; gap: 20px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 250px;">
          <%= form.label :strNombreModulo, "Nombre del Módulo *", style: "display: block; font-weight: 600; margin-bottom: 8px; color: var(--text-light);" %>
          <%= form.text_field :strNombreModulo, class: "glass-input", required: true, style: "margin: 0;" %>
        </div>
        <div style="flex: 1; min-width: 250px;">
          <%= form.label :strIcono_Modulo, "Icono del Módulo", style: "display: block; font-weight: 600; margin-bottom: 8px; color: var(--text-light);" %>
          <%= form.text_field :strIcono_Modulo, id: "icono-modulo-input", class: "glass-input", style: "margin: 0;" %>
        </div>
      </div>
    </div>

    <div style="background: rgba(255,255,255,0.3); border-radius: 16px; padding: 25px; margin-bottom: 30px;">
      <h3 style="margin-top: 0; color: var(--text-dark);">2. Ubicación en el Menú</h3>
      <div style="margin-bottom: 20px;">
        <label style="display: block; font-weight: 600; margin-bottom: 8px; color: var(--text-light);">Selecciona un Apartado Existente:</label>
        <%= form.collection_select :apartado_id, Apartado.all, :id, :strNombre_Apartado, { prompt: "Seleccione uno..." }, { class: "glass-input", style: "margin: 0;" } %>
      </div>

      <div style="background: rgba(255,255,255,0.5); padding: 20px; border-radius: 12px; border: 1px dashed var(--glass-border);">
        <label style="display: block; font-weight: bold; margin-bottom: 15px; color: var(--accent);">¿O quieres crear un NUEVO Apartado?</label>
        <div style="display: flex; gap: 20px; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 200px;">
            <input type="text" name="nuevo_apartado_nombre" placeholder="Nombre" class="glass-input valida-nombre" style="margin: 0;">
          </div>
          <div style="flex: 1; min-width: 200px;">
            <input type="text" name="nuevo_apartado_icono" id="icono-apartado-input" placeholder="Icono" class="glass-input" style="margin: 0;">
          </div>
        </div>
      </div>
    </div>

    <div style="display: flex; gap: 15px; justify-content: flex-end;">
      <%= link_to "Cancelar", modulos_path, class: "glass-btn glass-btn-outline" %>
      <%= form.submit "Guardar Módulo", class: "glass-btn" %>
    </div>
  <% end %>
</div>