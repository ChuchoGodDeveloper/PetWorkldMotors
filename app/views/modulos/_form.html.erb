<div class="neo-container" style="max-width: 800px; margin: 0 auto; padding: 30px;">
  <h2 class="neo-title" style="text-align: center; margin-bottom: 30px;">
    <%= @modulo.new_record? ? 'Nuevo Módulo' : 'Editar Módulo' %>
  </h2>

  <%= form_with(model: @modulo, local: true) do |form| %>
    
    <% if @modulo.errors.any? %>
      <div class="error-msg" style="display: block; color: var(--danger); background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); padding: 15px; border-radius: 12px; margin-bottom: 20px;">
        <ul style="margin: 0; padding-left: 20px;">
          <% @modulo.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="padding: 20px; border-bottom: 1px solid var(--bento-border); margin-bottom: 20px;">
      <h3 class="neo-subtitle" style="margin-bottom: 20px; color: var(--text-primary); font-weight: bold;">1. Datos del Módulo</h3>
      <div style="display: flex; gap: 20px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 250px;">
          <%= form.label :strNombreModulo, "Nombre del Módulo *", class: "neo-subtitle", style: "display: block; font-weight: bold; margin-bottom: 10px;" %>
          <%= form.text_field :strNombreModulo, placeholder: "Ej: Clientes...", class: "neo-input", required: true, minlength: "3", style: "width: 100%; margin-bottom: 5px;" %>
        </div>
        <div style="flex: 1; min-width: 250px;">
          <%= form.label :strIcono_Modulo, "Icono del Módulo", class: "neo-subtitle", style: "display: block; font-weight: bold; margin-bottom: 10px;" %>
          <%= form.text_field :strIcono_Modulo, id: "icono-modulo-input", placeholder: "Ej: fas fa-car", class: "neo-input", style: "width: 100%; margin-bottom: 5px;" %>
        </div>
      </div>
    </div>

    <div style="padding: 20px; border-bottom: 1px solid var(--bento-border); margin-bottom: 30px;">
      <h3 class="neo-subtitle" style="margin-bottom: 20px; color: var(--text-primary); font-weight: bold;">2. Ubicación en el Menú</h3>
      <div style="margin-bottom: 20px;">
        <label class="neo-subtitle" style="display: block; font-weight: bold; margin-bottom: 10px;">Selecciona un Apartado Existente:</label>
        <%= form.collection_select :apartado_id, Apartado.all, :id, :strNombre_Apartado, { prompt: "Seleccione uno..." }, { class: "neo-input", style: "width: 100%; appearance: auto;" } %>
      </div>

      <div style="padding: 15px; border-radius: 12px; background: var(--bg-base); border: 1px solid var(--bento-border);">
        <label class="neo-subtitle" style="display: block; font-weight: bold; margin-bottom: 10px; color: var(--accent);">¿O quieres crear un NUEVO Apartado?</label>
        <div style="display: flex; gap: 20px; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 200px;">
            <input type="text" name="nuevo_apartado_nombre" placeholder="Nombre del nuevo apartado" class="neo-input valida-nombre" minlength="3" style="width: 100%;">
          </div>
          <div style="flex: 1; min-width: 200px;">
            <input type="text" name="nuevo_apartado_icono" id="icono-apartado-input" placeholder="Icono del nuevo apartado" class="neo-input" style="width: 100%;">
          </div>
        </div>
      </div>
    </div>

    <div style="padding: 20px; margin-bottom: 30px;">
      <h3 class="neo-subtitle" style="margin-bottom: 10px; color: var(--text-primary); font-weight: bold;">Catálogo de Iconos Rápido</h3>
      <div id="icon-catalog" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(50px, 1fr)); gap: 15px;"></div>
    </div>

    <div style="display: flex; gap: 15px; justify-content: flex-end;">
      <%= link_to "Cancelar", modulos_path, class: "neo-button", style: "text-decoration: none; padding: 12px 30px; display: flex; align-items: center; width: auto; background: transparent; border: 1px solid var(--bento-border); color: var(--text-secondary);" %>
      <%= form.submit "Guardar Módulo", class: "neo-button", style: "padding: 12px 40px; width: auto;" %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const iconos = ['fas fa-users', 'fas fa-user-tie', 'fas fa-user-shield', 'fas fa-id-badge', 'fas fa-address-card', 'fas fa-user-cog', 'fas fa-cubes', 'fas fa-layer-group', 'fas fa-puzzle-piece', 'fas fa-sitemap', 'fas fa-th-large', 'fas fa-bars', 'fas fa-shield-alt', 'fas fa-key', 'fas fa-lock', 'fas fa-unlock-alt', 'fas fa-fingerprint', 'fas fa-chart-line', 'fas fa-chart-pie', 'fas fa-chart-bar', 'fas fa-file-invoice-dollar', 'fas fa-wallet', 'fas fa-briefcase', 'fas fa-building', 'fas fa-store', 'fas fa-cash-register', 'fas fa-tags', 'fas fa-cog', 'fas fa-cogs', 'fas fa-sliders-h', 'fas fa-database', 'fas fa-server', 'fas fa-laptop-code', 'fas fa-car', 'fas fa-motorcycle', 'fas fa-truck', 'fas fa-wrench', 'fas fa-toolbox', 'fas fa-home', 'fas fa-envelope', 'fas fa-bell', 'fas fa-calendar-alt', 'fas fa-box', 'fas fa-clipboard-list'];
    const catalog = document.getElementById('icon-catalog');

    iconos.forEach(icono => {
      const btn = document.createElement('div');
      btn.className = 'neo-button';
      btn.style.cssText = 'width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; font-size: 20px; cursor: pointer; padding: 0; transition: all 0.2s;';
      btn.innerHTML = `<i class="${icono}"></i>`;
      btn.onmouseover = () => btn.style.color = 'var(--accent)';
      btn.onmouseout = () => btn.style.color = '';
      btn.onclick = () => {
        navigator.clipboard.writeText(icono);
        const iconoOriginal = btn.innerHTML;
        btn.innerHTML = `<i class="fas fa-check" style="color: var(--success);"></i>`;
        setTimeout(() => btn.innerHTML = iconoOriginal, 1000);
      };
      catalog.appendChild(btn);
    });
  });
</script>