<div class="neo-container" style="max-width: 800px; margin: 0 auto; padding: 30px;">
  <h2 class="neo-title" style="text-align: center; margin-bottom: 30px;">
    <%= @modulo.new_record? ? 'Nuevo Módulo' : 'Editar Módulo' %>
  </h2>

  <%= form_with(model: @modulo, local: true) do |form| %>
    
    <% if @modulo.errors.any? %>
      <div class="error-msg" style="color: #ff4757; margin-bottom: 20px;">
        <ul style="margin: 0; padding-left: 20px;">
          <% @modulo.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="padding: 20px; border-bottom: 2px solid rgba(163,177,198,0.3); margin-bottom: 20px;">
      <h3 class="neo-subtitle" style="margin-bottom: 20px; color: #333;">1. Datos del Módulo</h3>
      
      <div style="display: flex; gap: 20px; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 250px;">
          <%= form.label :strNombreModulo, "Nombre del Módulo *", class: "neo-subtitle", style: "display: block; font-weight: bold; margin-bottom: 10px;" %>
          <%= form.text_field :strNombreModulo, placeholder: "Ej: Clientes, Reportes...", class: "neo-input", required: true, style: "width: 100%; margin-bottom: 5px;" %>
        </div>

        <div style="flex: 1; min-width: 250px;">
          <%= form.label :strIcono_Modulo, "Icono del Módulo", class: "neo-subtitle", style: "display: block; font-weight: bold; margin-bottom: 10px;" %>
          <%= form.text_field :strIcono_Modulo, id: "icono-modulo-input", placeholder: "Ej: fas fa-car", class: "neo-input", style: "width: 100%; margin-bottom: 5px;" %>
        </div>
      </div>
    </div>

    <div style="padding: 20px; border-bottom: 2px solid rgba(163,177,198,0.3); margin-bottom: 30px;">
      <h3 class="neo-subtitle" style="margin-bottom: 20px; color: #333;">2. Ubicación en el Menú</h3>
      
      <div style="margin-bottom: 20px;">
        <label class="neo-subtitle" style="display: block; font-weight: bold; margin-bottom: 10px;">Selecciona un Apartado Existente:</label>
        <%= form.collection_select :apartado_id, Apartado.all, :id, :strNombre_Apartado, { prompt: "Seleccione uno..." }, { class: "neo-input", style: "width: 100%; appearance: auto;" } %>
      </div>

      <div style="padding: 15px; border-radius: 10px; background: rgba(163,177,198,0.1);">
        <label class="neo-subtitle" style="display: block; font-weight: bold; margin-bottom: 10px; color: #2e8b57;">¿O quieres crear un NUEVO Apartado?</label>
        <p style="font-size: 13px; color: #666; margin-bottom: 15px;">Llena esto solo si quieres crear una categoría nueva (Ej. "Inventario").</p>
        
        <div style="display: flex; gap: 20px; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 200px;">
            <input type="text" name="nuevo_apartado_nombre" placeholder="Nombre del nuevo apartado" class="neo-input" style="width: 100%;">
          </div>
          <div style="flex: 1; min-width: 200px;">
            <input type="text" name="nuevo_apartado_icono" id="icono-apartado-input" placeholder="Icono del nuevo apartado" class="neo-input" style="width: 100%;">
          </div>
        </div>
      </div>
    </div>

    <div style="padding: 20px; margin-bottom: 30px;">
      <h3 class="neo-subtitle" style="margin-bottom: 10px; color: #333;">Catálogo de Iconos Rápido</h3>
      <p style="font-size: 13px; color: #666; margin-bottom: 15px;">Da clic en un icono para copiar su código. Pégalo en los campos de arriba.</p>
      
      <div id="icon-catalog" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(50px, 1fr)); gap: 15px;">
        </div>
    </div>

    <div style="display: flex; gap: 15px; justify-content: flex-end;">
      <%= link_to "Cancelar", modulos_path, class: "neo-button", style: "text-decoration: none; padding: 12px 30px; display: flex; align-items: center;" %>
      <%= form.submit "Guardar Módulo", class: "neo-button", style: "padding: 12px 40px;" %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Lista de iconos comunes de FontAwesome
    const iconos = [
      'fas fa-car', 'fas fa-motorcycle', 'fas fa-users', 'fas fa-shield-alt', 
      'fas fa-box', 'fas fa-wrench', 'fas fa-chart-line', 'fas fa-cog',
      'fas fa-file-invoice', 'fas fa-store', 'fas fa-cash-register', 'fas fa-calendar'
    ];

    const catalog = document.getElementById('icon-catalog');

    iconos.forEach(icono => {
      const btn = document.createElement('div');
      btn.className = 'neo-button';
      btn.style.cssText = 'width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; font-size: 20px; cursor: pointer; padding: 0;';
      btn.innerHTML = `<i class="${icono}"></i>`;
      
      // Al hacer clic, copia el nombre de la clase al portapapeles
      btn.onclick = () => {
        navigator.clipboard.writeText(icono);
        alert(`Icono '${icono}' copiado al portapapeles. Pégalo en el campo que necesites.`);
      };
      
      catalog.appendChild(btn);
    });
  });
</script>