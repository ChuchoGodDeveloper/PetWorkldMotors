<div class="neo-container" style="max-width: 800px; margin: 0 auto;">
  <div style="text-align: center; margin-bottom: 20px;">
    <h2 class="neo-title">PetWorld Motors</h2>
    <div class="neo-subtitle">Panel de Administración</div>
    <p style="color: var(--text-secondary);">Bienvenido a tu espacio de trabajo.</p>
  </div>

  <div id="perfil-usuario" style="display: none; padding: 20px; border-top: 1px solid var(--bento-border); margin-top: 20px;">
    <h3 class="neo-subtitle" style="text-align: center; margin-bottom: 20px; color: var(--text-primary); font-weight: bold;">Mis Datos Generales</h3>
    
    <div style="display: flex; flex-wrap: wrap; gap: 30px; justify-content: center; align-items: flex-start;">
      
      <div style="text-align: center;">
        <img id="user-img" src="" alt="Foto de perfil" style="display: none; width: 120px; height: 120px; border-radius: 30px; object-fit: cover; border: 2px solid var(--bento-border); margin-bottom: 10px;">
        <div id="user-no-img" style="display: flex; align-items: center; justify-content: center; width: 120px; height: 120px; border-radius: 30px; background-color: var(--bg-base); border: 1px dashed var(--bento-border); color: var(--text-secondary); margin-bottom: 10px; font-size: 0.9rem;">
          Sin Imagen
        </div>
        <span id="user-estado" style="display: inline-block; padding: 5px 15px; border-radius: 20px; font-size: 0.85rem; font-weight: bold; color: var(--success); background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2);">
          Cargando...
        </span>
      </div>

      <div style="flex-grow: 1; min-width: 250px; display: grid; grid-template-columns: 1fr; gap: 15px;">
        <div class="neo-input" style="padding: 15px; margin: 0; background: transparent; pointer-events: none;">
          <label style="display: block; font-size: 0.8rem; color: var(--text-secondary); font-weight: bold; text-transform: uppercase;">Usuario</label>
          <div id="user-nombre" style="font-size: 1.1rem; color: var(--text-primary); font-weight: bold;">Cargando...</div>
        </div>
        
        <div class="neo-input" style="padding: 15px; margin: 0; background: transparent; pointer-events: none;">
          <label style="display: block; font-size: 0.8rem; color: var(--text-secondary); font-weight: bold; text-transform: uppercase;">Perfil de Acceso</label>
          <div id="user-perfil" style="font-size: 1.1rem; color: var(--text-primary);">Cargando...</div>
        </div>

        <div class="neo-input" style="padding: 15px; margin: 0; background: transparent; pointer-events: none;">
          <label style="display: block; font-size: 0.8rem; color: var(--text-secondary); font-weight: bold; text-transform: uppercase;">Correo Electrónico</label>
          <div id="user-correo" style="font-size: 1.1rem; color: var(--text-primary);">Cargando...</div>
        </div>

        <div class="neo-input" style="padding: 15px; margin: 0; background: transparent; pointer-events: none;">
          <label style="display: block; font-size: 0.8rem; color: var(--text-secondary); font-weight: bold; text-transform: uppercase;">Teléfono Celular</label>
          <div id="user-celular" style="font-size: 1.1rem; color: var(--text-primary);">Cargando...</div>
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const token = localStorage.getItem('jwt_token');

    if (!token) {
      window.location.href = '/sessions/new'; 
      return;
    }

    fetch('/api/perfil', {
      method: 'GET',
      headers: {
        'Authorization': `Bearer ${token}`,
        'Content-Type': 'application/json'
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        document.getElementById('perfil-usuario').style.display = 'block';
        
        document.getElementById('user-nombre').textContent = data.nombre;
        document.getElementById('user-correo').textContent = data.correo;
        document.getElementById('user-perfil').textContent = data.perfil;
        document.getElementById('user-celular').textContent = data.celular;
        
        const estadoSpan = document.getElementById('user-estado');
        estadoSpan.textContent = data.estado;
        if(data.estado !== 'Activo') {
          estadoSpan.style.color = 'var(--text-secondary)'; 
          estadoSpan.style.background = 'transparent';
          estadoSpan.style.borderColor = 'var(--text-secondary)';
        }

        if (data.imagen_url) {
          const imgEl = document.getElementById('user-img');
          imgEl.src = data.imagen_url;
          imgEl.style.display = 'block';
          document.getElementById('user-no-img').style.display = 'none';
        }

      } else {
        localStorage.removeItem('jwt_token');
        window.location.href = '/sessions/new';
      }
    })
    .catch(error => {
      console.error("Error al obtener los datos:", error);
    });
  });
</script>