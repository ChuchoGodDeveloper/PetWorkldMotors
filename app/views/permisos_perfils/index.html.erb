<div class="glass-container" style="max-width: 1000px; margin: 0 auto;">
  
  <div style="font-size: 14px; color: var(--text-light); margin-bottom: 30px;">
    <a href="/principal" style="color: var(--accent); text-decoration: none; font-weight: 600;">Inicio</a> > Seguridad > Permisos Perfil
  </div>

  <h2 class="glass-title" style="text-align: center; margin-bottom: 40px;">Matriz de Permisos por Perfil</h2>

  <div style="display: flex; justify-content: center; margin-bottom: 40px; width: 100%;">
    <div style="width: 100%; max-width: 400px; background: rgba(255,255,255,0.3); padding: 20px; border-radius: 16px; border: 1px solid var(--glass-border);">
      <label style="font-size: 14px; color: var(--text-dark); margin-bottom: 10px; display: block; font-weight: 600;">Selecciona el Perfil a configurar:</label>
      <select id="idPerfil" class="glass-input" style="margin: 0; padding: 12px; cursor: pointer;">
        <option value="">Seleccione un perfil...</option>
      </select>
    </div>
  </div>

  <div style="background: rgba(255,255,255,0.3); border-radius: 16px; padding: 20px; border: 1px solid var(--glass-border); overflow-x: auto;">
    <table style="width: 100%; text-align: left;">
      <thead>
        <tr>
          <th style="padding: 15px; font-weight: 600; color: var(--text-light); border-bottom: 2px solid var(--glass-border);">Módulo</th>
          <th style="padding: 15px; font-weight: 600; color: var(--text-light); text-align: center; border-bottom: 2px solid var(--glass-border);">Agregar</th>
          <th style="padding: 15px; font-weight: 600; color: var(--text-light); text-align: center; border-bottom: 2px solid var(--glass-border);">Editar</th>
          <th style="padding: 15px; font-weight: 600; color: var(--text-light); text-align: center; border-bottom: 2px solid var(--glass-border);">Consulta</th>
          <th style="padding: 15px; font-weight: 600; color: var(--text-light); text-align: center; border-bottom: 2px solid var(--glass-border);">Eliminar</th>
          <th style="padding: 15px; font-weight: 600; color: var(--text-light); text-align: center; border-bottom: 2px solid var(--glass-border);">Detalle</th>
        </tr>
      </thead>
      <tbody id="tabla-permisos">
        <tr>
          <td colspan="6" style="padding: 40px; text-align: center; color: var(--text-light); font-style: italic;">
            Seleccione un perfil para cargar los módulos.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <div style="width: 100%; display: flex; justify-content: flex-end; margin-top: 30px;">
    <button type="button" class="glass-btn" style="display: none; min-width: 200px;" id="btn-guardar">Guardar Cambios</button>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const token = localStorage.getItem('jwt_token');
  if (!token) window.location.replace('/login');

  const perfiles = <%= raw Perfil.all.select(:id, :strNombre_Perfil).to_json %>;
  const modulos = <%= raw Modulo.all.select(:id, :strNombreModulo).to_json %>;

  const selectPerfil = document.getElementById('idPerfil');
  const tabla = document.getElementById('tabla-permisos');
  const btnGuardar = document.getElementById('btn-guardar');

  perfiles.forEach(p => selectPerfil.add(new Option(p.strNombre_Perfil, p.id)));

  const cargarPermisos = async () => {
    const perfilId = selectPerfil.value;
    tabla.innerHTML = ''; 

    if (!perfilId) {
      btnGuardar.style.display = 'none';
      tabla.innerHTML = `<tr><td colspan="6" style="padding: 40px; text-align: center; color: var(--text-light); font-style: italic;">Selecciona un perfil en la lista superior para configurar sus permisos.</td></tr>`;
      return;
    }

    try {
      const res = await fetch(`/permisos_perfils.json?perfil_id=${perfilId}`);
      const permisosExistentes = await res.json();
      
      const mapPermisos = {};
      permisosExistentes.forEach(p => mapPermisos[p.idModulo] = p);

      modulos.forEach(modulo => {
        const perm = mapPermisos[modulo.id] || {}; 
        
        const tr = document.createElement('tr');
        tr.className = 'fila-modulo';
        tr.dataset.modulo = modulo.id;
        tr.dataset.permiso = perm.id || ''; 
        
        // Se cambiaron los estilos en línea a los compatibles con Glassmorphism
        tr.innerHTML = `
          <td style="padding: 15px; color: var(--text-dark); font-weight: 600; border-bottom: 1px solid var(--glass-border);">
            <i class="fas fa-folder" style="color: var(--accent); margin-right: 10px;"></i> ${modulo.strNombreModulo}
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid var(--glass-border);">
            <input type="checkbox" class="chk-agregar" style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--accent);" ${perm.bitAgregar ? 'checked' : ''}>
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid var(--glass-border);">
            <input type="checkbox" class="chk-editar" style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--accent);" ${perm.bitEditar ? 'checked' : ''}>
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid var(--glass-border);">
            <input type="checkbox" class="chk-consulta" style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--accent);" ${perm.bitConsulta ? 'checked' : ''}>
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid var(--glass-border);">
            <input type="checkbox" class="chk-eliminar" style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--accent);" ${perm.bitEliminar ? 'checked' : ''}>
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid var(--glass-border);">
            <input type="checkbox" class="chk-detalle" style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--accent);" ${perm.bitDetalle ? 'checked' : ''}>
          </td>
        `;
        tabla.appendChild(tr);
      });

      btnGuardar.style.display = 'block'; 

    } catch (error) {
      console.error('Error al cargar permisos:', error);
      alert('Error al cargar los permisos del perfil.');
    }
  };

  selectPerfil.addEventListener('change', cargarPermisos);

  btnGuardar.addEventListener('click', async () => {
    const perfilId = selectPerfil.value;
    if (!perfilId) return;

    btnGuardar.innerText = 'Guardando...';
    btnGuardar.disabled = true;

    const filas = document.querySelectorAll('.fila-modulo');
    const promesas = [];

    filas.forEach(tr => {
      const idModulo = tr.dataset.modulo;
      const idPermiso = tr.dataset.permiso;
      
      const payload = {
        permisos_perfil: {
          idPerfil: perfilId,
          idModulo: idModulo,
          bitAgregar: tr.querySelector('.chk-agregar').checked,
          bitEditar: tr.querySelector('.chk-editar').checked,
          bitConsulta: tr.querySelector('.chk-consulta').checked,
          bitEliminar: tr.querySelector('.chk-eliminar').checked,
          bitDetalle: tr.querySelector('.chk-detalle').checked
        }
      };

      const url = idPermiso ? `/permisos_perfils/${idPermiso}.json` : '/permisos_perfils.json';
      const method = idPermiso ? 'PUT' : 'POST';

      promesas.push(
        fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
      );
    });

    try {
      await Promise.all(promesas);
      alert('¡Permisos actualizados correctamente!');
      cargarPermisos(); 
    } catch (error) {
      console.error('Error al guardar:', error);
      alert('Ocurrió un error al guardar algunos permisos.');
    } finally {
      btnGuardar.innerText = 'Guardar Cambios';
      btnGuardar.disabled = false;
    }
  });

});
</script>