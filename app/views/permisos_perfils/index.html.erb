<div class="neo-container" style="width: 100%; max-width: 1000px; margin: 0 auto; padding: 40px;">
  
  <div style="text-align: left; font-size: 14px; color: #888; margin-bottom: 30px;">
    <a href="/principal" style="color: #888; text-decoration: none;">Inicio</a> > Seguridad > Permisos Perfil
  </div>

  <h2 class="neo-title" style="text-align: center; margin-bottom: 40px;">Matriz de Permisos por Perfil</h2>

  <div style="display: flex; justify-content: center; margin-bottom: 30px; width: 100%;">
    <div style="width: 50%; text-align: center;">
      <label style="font-size: 16px; color: #666; margin-bottom: 10px; display: block; font-weight: bold;">Selecciona el Perfil a configurar:</label>
      <select id="idPerfil" class="neo-input" style="width: 100%; margin: 0; padding: 10px; border-radius: 8px;">
        <option value="">Seleccione un perfil...</option>
      </select>
    </div>
  </div>

  <div style="overflow-x: auto; background: #fdfdfd; border-radius: 10px; padding: 20px; box-shadow: inset 2px 2px 5px rgba(0,0,0,0.05);">
    <table style="width: 100%; border-collapse: separate; border-spacing: 0; text-align: left; color: #4a4a4a; font-size: 15px;">
      <thead>
        <tr>
          <th style="padding: 15px; font-weight: bold; border-bottom: 2px solid rgba(163,177,198,0.3);">Módulo</th>
          <th style="padding: 15px; font-weight: bold; text-align: center; border-bottom: 2px solid rgba(163,177,198,0.3);">Agregar</th>
          <th style="padding: 15px; font-weight: bold; text-align: center; border-bottom: 2px solid rgba(163,177,198,0.3);">Editar</th>
          <th style="padding: 15px; font-weight: bold; text-align: center; border-bottom: 2px solid rgba(163,177,198,0.3);">Consulta</th>
          <th style="padding: 15px; font-weight: bold; text-align: center; border-bottom: 2px solid rgba(163,177,198,0.3);">Eliminar</th>
          <th style="padding: 15px; font-weight: bold; text-align: center; border-bottom: 2px solid rgba(163,177,198,0.3);">Detalle</th>
        </tr>
      </thead>
      <tbody id="tabla-permisos">
        <tr>
          <td colspan="6" style="padding: 30px; text-align: center; color: #999; font-style: italic;">
            Seleccione un perfil para cargar los módulos.
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <div style="width: 100%; display: flex; justify-content: flex-end; margin-top: 30px;">
    <button type="button" class="neo-button" style="width: auto; padding: 12px 40px; font-weight: bold; display: none;" id="btn-guardar">Guardar Cambios</button>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const token = localStorage.getItem('jwt_token');
  if (!token) window.location.replace('/login');

  const perfiles = <%= raw Perfil.all.select(:id, :strNombre_Perfil).to_json %>;
  const modulos = <%= raw Modulo.all.select(:id, :strNombreModulo).to_json %>;

  const selectPerfil = document.getElementById('idPerfil');
  const tabla = document.getElementById('tabla-permisos');
  const btnGuardar = document.getElementById('btn-guardar');

  // Llenar selector de perfiles
  perfiles.forEach(p => selectPerfil.add(new Option(p.strNombre_Perfil, p.id)));

  // Cargar Matriz
  const cargarPermisos = async () => {
    const perfilId = selectPerfil.value;
    tabla.innerHTML = ''; 

    if (!perfilId) {
      btnGuardar.style.display = 'none';
      tabla.innerHTML = `<tr><td colspan="6" style="padding: 30px; text-align: center; color: #999; font-style: italic;">Selecciona un perfil en la lista superior para configurar sus permisos.</td></tr>`;
      return;
    }

    try {
      // Obtenemos los permisos que ya existen para este perfil
      const res = await fetch(`/permisos_perfils.json?perfil_id=${perfilId}`);
      const permisosExistentes = await res.json();
      
      // Creamos un diccionario para buscar rápido si el módulo ya tiene permisos
      const mapPermisos = {};
      permisosExistentes.forEach(p => mapPermisos[p.idModulo] = p);

      // Renderizamos TODOS los módulos disponibles en la tabla
      modulos.forEach(modulo => {
        const perm = mapPermisos[modulo.id] || {}; // Si no hay permiso, devuelve objeto vacío
        
        const tr = document.createElement('tr');
        tr.className = 'fila-modulo';
        tr.dataset.modulo = modulo.id;
        tr.dataset.permiso = perm.id || ''; // Guardamos el ID del registro si existe para hacer PUT luego
        
        tr.innerHTML = `
          <td style="padding: 15px; color: #4a4a4a; font-weight: bold; border-bottom: 1px solid rgba(163,177,198,0.2);">
            <i class="fas fa-folder" style="color: #6c5ce7; margin-right: 8px;"></i> ${modulo.strNombreModulo}
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid rgba(163,177,198,0.2);">
            <input type="checkbox" class="chk-agregar" style="width: 18px; height: 18px; cursor: pointer;" ${perm.bitAgregar ? 'checked' : ''}>
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid rgba(163,177,198,0.2);">
            <input type="checkbox" class="chk-editar" style="width: 18px; height: 18px; cursor: pointer;" ${perm.bitEditar ? 'checked' : ''}>
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid rgba(163,177,198,0.2);">
            <input type="checkbox" class="chk-consulta" style="width: 18px; height: 18px; cursor: pointer;" ${perm.bitConsulta ? 'checked' : ''}>
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid rgba(163,177,198,0.2);">
            <input type="checkbox" class="chk-eliminar" style="width: 18px; height: 18px; cursor: pointer;" ${perm.bitEliminar ? 'checked' : ''}>
          </td>
          <td style="padding: 15px; text-align: center; border-bottom: 1px solid rgba(163,177,198,0.2);">
            <input type="checkbox" class="chk-detalle" style="width: 18px; height: 18px; cursor: pointer;" ${perm.bitDetalle ? 'checked' : ''}>
          </td>
        `;
        tabla.appendChild(tr);
      });

      btnGuardar.style.display = 'block'; // Mostramos el botón de guardar

    } catch (error) {
      console.error('Error al cargar permisos:', error);
      alert('Error al cargar los permisos del perfil.');
    }
  };

  selectPerfil.addEventListener('change', cargarPermisos);

  // Guardar Matriz (Procesa todas las filas)
  btnGuardar.addEventListener('click', async () => {
    const perfilId = selectPerfil.value;
    if (!perfilId) return;

    btnGuardar.innerText = 'Guardando...';
    btnGuardar.disabled = true;

    const filas = document.querySelectorAll('.fila-modulo');
    const promesas = [];

    filas.forEach(tr => {
      const idModulo = tr.dataset.modulo;
      const idPermiso = tr.dataset.permiso;
      
      const payload = {
        permisos_perfil: {
          idPerfil: perfilId,
          idModulo: idModulo,
          bitAgregar: tr.querySelector('.chk-agregar').checked,
          bitEditar: tr.querySelector('.chk-editar').checked,
          bitConsulta: tr.querySelector('.chk-consulta').checked,
          bitEliminar: tr.querySelector('.chk-eliminar').checked,
          bitDetalle: tr.querySelector('.chk-detalle').checked
        }
      };

      // Si el registro ya existe hacemos PUT, si es nuevo POST
      const url = idPermiso ? `/permisos_perfils/${idPermiso}.json` : '/permisos_perfils.json';
      const method = idPermiso ? 'PUT' : 'POST';

      promesas.push(
        fetch(url, {
          method: method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
      );
    });

    try {
      // Esperamos a que todas las peticiones terminen
      await Promise.all(promesas);
      alert('¡Permisos actualizados correctamente!');
      cargarPermisos(); // Recargamos para actualizar los IDs internos de los registros nuevos
    } catch (error) {
      console.error('Error al guardar:', error);
      alert('Ocurrió un error al guardar algunos permisos.');
    } finally {
      btnGuardar.innerText = 'Guardar Cambios';
      btnGuardar.disabled = false;
    }
  });

});
</script>