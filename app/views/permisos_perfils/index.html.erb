<div class="neo-container" style="width: 100%; max-width: 1000px; margin: 0 auto; padding: 40px; background-color: #e0e5ec; border-radius: 20px; box-shadow: 20px 20px 60px #bebebe, -20px -20px 60px #ffffff;">
  
  <%= form_with url: permisos_perfils_path, method: :get, local: true, id: "form-selector-perfil" do %>
    <div style="display: flex; align-items: center; gap: 15px; margin-bottom: 30px; padding: 20px; border-radius: 15px; background: #fdfdfd; border: 1px solid #e1e4e8; box-shadow: inset 2px 2px 5px rgba(0,0,0,0.05);">
      <label style="margin: 0; color: #3b1c94; font-weight: 600; white-space: nowrap;">Seleccionar Perfil:</label>
      <%= select_tag :perfil_id, 
            options_from_collection_for_select(@perfiles, :id, :strNombre_Perfil, params[:perfil_id]), 
            prompt: "Elija un perfil...", 
            style: "flex: 1; max-width: 300px; padding: 8px; border-radius: 8px; border: 1px solid #ccc; outline: none;",
            onchange: "document.getElementById('form-selector-perfil').submit();" %>
    </div>
  <% end %>

  <% if @perfil_seleccionado %>
    <%= form_with url: guardar_matriz_permisos_path, method: :post, local: true do |f| %>
      <%= hidden_field_tag :perfil_id, @perfil_seleccionado.id %>

      <div style="background: #ffffff; border-radius: 10px; overflow: hidden; box-shadow: 4px 4px 10px rgba(0,0,0,0.05); margin-bottom: 30px;">
        <table style="width: 100%; border-collapse: collapse; text-align: center;">
          <thead>
            <tr style="color: #3b1c94; font-weight: bold; border-bottom: 2px solid #e1e4e8;">
              <th style="padding: 15px; text-align: left;">Módulo</th>
              <th style="padding: 15px;">Agregar</th>
              <th style="padding: 15px;">Editar</th>
              <th style="padding: 15px;">Eliminar</th>
              <th style="padding: 15px;">Consultar</th>
            </tr>
          </thead>
          <tbody>
            <%# Iteramos sobre los apartados para agrupar (Ej. SEGURIDAD, PRINCIPAL 1) %>
            <% Apartado.includes(:modulos).order(:strNombre_Apartado).each do |apartado| %>
              
              <tr style="background-color: #f8f9fa;">
                <td colspan="5" style="padding: 12px 15px; text-align: left; font-weight: bold; color: #3b1c94; text-transform: uppercase; border-bottom: 1px solid #e1e4e8; border-top: 1px solid #e1e4e8;">
                  <i class="fas fa-folder-open" style="margin-right: 8px;"></i> <%= apartado.strNombre_Apartado %>
                </td>
              </tr>

              <% apartado.modulos.each do |modulo| %>
                <% permiso = PermisosPerfil.find_by(idPerfil: @perfil_seleccionado.id, idModulo: modulo.id) %>
                
                <tr style="border-bottom: 1px solid #f1f3f5;">
                  <td style="padding: 15px; text-align: left; color: #4a5568; padding-left: 30px;">
                    <%= modulo.strNombreModulo %>
                  </td>
                  <td><%= check_box_tag "permisos[#{modulo.id}][bitAlta]", 1, permiso&.bitAlta, class: "custom-checkbox" %></td>
                  <td><%= check_box_tag "permisos[#{modulo.id}][bitEdicion]", 1, permiso&.bitEdicion, class: "custom-checkbox" %></td>
                  <td><%= check_box_tag "permisos[#{modulo.id}][bitBaja]", 1, permiso&.bitBaja, class: "custom-checkbox" %></td>
                  <td><%= check_box_tag "permisos[#{modulo.id}][bitConsulta]", 1, permiso&.bitConsulta, class: "custom-checkbox" %></td>
                </tr>
              <% end %>
              
            <% end %>
          </tbody>
        </table>
      </div>

      <div style="text-align: right;">
        <%= f.submit "Guardar Cambios", style: "padding: 10px 25px; border-radius: 8px; background-color: #e0e5ec; box-shadow: 4px 4px 8px #babecc, -4px -4px 8px #ffffff; color: #3b1c94; font-weight: bold; border: none; cursor: pointer;" %>
      </div>
    <% end %>
  <% else %>
    <div style="text-align: center; padding: 40px; color: #a3b1c6; font-style: italic;">
      Selecciona un perfil en la lista superior para ver sus permisos asignados.
    </div>
  <% end %>
</div>

<style>
  /* Ajuste para que los checkboxes se vean limpios como en tu imagen */
  .custom-checkbox {
    width: 18px;
    height: 18px;
    cursor: pointer;
    accent-color: #a3b1c6; 
  }
</style>