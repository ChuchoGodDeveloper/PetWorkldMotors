<div class="neo-container" style="width: 100%; max-width: 1200px;">
  
  <div style="background-color: #1a2b4c; color: white; padding: 15px 20px; border-radius: 12px 12px 0 0; display: flex; justify-content: space-between; align-items: center; border: 2px solid #e0e6ed; border-bottom: none;">
    <h2 style="margin: 0; font-size: 1.2rem; display: flex; align-items: center; gap: 10px;">
      <i class="fas fa-id-badge"></i> Gestión de Perfiles
    </h2>
    <%= link_to new_perfil_path, class: "neo-button", style: "padding: 8px 15px; font-size: 0.9rem; background: transparent; border: 1px solid white; color: white; margin: 0;" do %>
      <i class="fas fa-plus"></i> Nuevo Perfil
    <% end %>
  </div>

  <div style="border: 2px solid #e0e6ed; border-radius: 0 0 12px 12px; padding: 20px; background-color: white;">
    
    <div style="margin-bottom: 20px;">
      <label style="font-weight: bold; font-size: 0.9rem; color: #1a2b4c; display: block; margin-bottom: 8px;">BUSCAR POR NOMBRE</label>
      <%= form_with url: perfils_path, method: :get, local: true, style: "display: flex; gap: 10px;" do |f| %>
        <%= f.text_field :q, value: params[:q], placeholder: "Nombre del perfil...", class: "neo-input", style: "flex-grow: 1; margin: 0;" %>
        <%= f.submit "Buscar", class: "neo-button", style: "margin: 0; background-color: #1a2b4c; color: white;" %>
      <% end %>
    </div>

    <table style="width: 100%; border-collapse: collapse; text-align: left;">
      <thead>
        <tr style="background-color: #1a2b4c; color: white;">
          <th style="padding: 12px 15px; border-radius: 8px 0 0 8px; width: 50px;">#</th>
          <th style="padding: 12px 15px;">NOMBRE DEL PERFIL</th>
          <th style="padding: 12px 15px; text-align: center; width: 150px;">ADMINISTRADOR</th>
          <th style="padding: 12px 15px; text-align: center; border-radius: 0 8px 8px 0; width: 150px;">ACCIONES</th>
        </tr>
      </thead>
      <tbody>
        <% @perfils.each do |perfil| %>
          <tr style="border-bottom: 1px solid #f0f0f0;">
            <td style="padding: 15px; color: #666;"><%= perfil.id %></td>
            <td style="padding: 15px; font-weight: bold; color: #333;"><%= perfil.strNombre_Perfil %></td>
            <td style="padding: 15px; text-align: center;">
              <% if perfil.bitAdministrador %>
                <span style="background-color: #1a2b4c; color: white; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: bold;">
                  <i class="fas fa-shield-alt"></i> SÍ
                </span>
              <% else %>
                <span style="background-color: #f0f0f0; color: #666; padding: 4px 12px; border-radius: 20px; font-size: 0.8rem; font-weight: bold;">
                  NO
                </span>
              <% end %>
            </td>
            <td style="padding: 15px; text-align: center;">
              <div style="display: flex; gap: 8px; justify-content: center;">
                <%= link_to edit_perfil_path(perfil), class: "neo-button", style: "padding: 5px 10px; margin: 0; background-color: white; border: 1px solid #ccc; color: #1a2b4c;" do %>
                  <i class="fas fa-pencil-alt"></i>
                <% end %>
                <%= button_to perfil_path(perfil), method: :delete, form: { data: { turbo_confirm: '¿Estás seguro?' } }, class: "neo-button", style: "padding: 5px 10px; margin: 0; background-color: white; border: 1px solid #ff4d4f; color: #ff4d4f;" do %>
                  <i class="fas fa-trash-alt"></i>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">