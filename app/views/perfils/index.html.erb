<div class="glass-container">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <h2 class="glass-title" style="margin: 0;">Gestión de Perfiles</h2>
    
    <% if tiene_permiso?('Perfils', :bitAgregar) %>
      <%= link_to 'Nuevo Perfil', new_perfil_path, class: "glass-btn" %>
    <% end %>
  </div>

  <div style="margin-bottom: 30px;">
    <label style="display: block; margin-bottom: 10px; font-weight: 600; color: var(--text-light);">BUSCAR POR NOMBRE</label>
    <input type="text" id="buscador-input" placeholder="🔍 Buscar perfil..." class="glass-input" style="margin: 0; max-width: 400px;" autocomplete="off">
  </div>

  <div style="background: rgba(255,255,255,0.3); border-radius: 16px; padding: 20px; overflow-x: auto; border: 1px solid var(--glass-border);">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>NOMBRE DEL PERFIL</th>
          <th style="text-align: center;">ADMINISTRADOR</th>
          <th style="text-align: center;">ACCIONES</th>
        </tr>
      </thead>
      <tbody>
        <% @perfils.each do |perfil| %>
          <tr class="fila-busqueda" data-search="<%= perfil.strNombre_Perfil.downcase %>">
            <td style="color: var(--text-light);"><%= perfil.id %></td>
            <td style="font-weight: bold;"><%= perfil.strNombre_Perfil %></td>
            <td style="text-align: center;">
              <span style="padding: 6px 12px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; background: <%= perfil.bitAdministrador ? 'rgba(37, 99, 235, 0.1)' : 'rgba(255, 255, 255, 0.4)' %>; color: <%= perfil.bitAdministrador ? 'var(--accent)' : 'var(--text-light)' %>;">
                <%= perfil.bitAdministrador ? 'Sí' : 'No' %>
              </span>
            </td>
            <td style="text-align: center;">
              <div style="display: flex; gap: 10px; justify-content: center;">
                
                <% if tiene_permiso?('Perfils', :bitEditar) %>
                  <%= link_to 'Editar', edit_perfil_path(perfil), class: "glass-btn glass-btn-outline", style: "padding: 8px 16px;" %>
                <% end %>

                <% if tiene_permiso?('Perfils', :bitEliminar) %>
                  <%= button_to 'Eliminar', perfil_path(perfil), method: :delete, form: { data: { turbo_confirm: '¿Estás seguro?' } }, class: "glass-btn glass-btn-danger", style: "padding: 8px 16px;" %>
                <% end %>

              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div style="margin-top: 20px;">
    <%= paginate @perfils if defined?(paginate) %>
  </div>
</div>

<script>
  document.getElementById('buscador-input').addEventListener('input', function (e) {
    const term = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('.fila-busqueda');

    rows.forEach(row => {
      const searchData = row.getAttribute('data-search');
      if (searchData.includes(term)) {
        row.style.display = ''; 
      } else {
        row.style.display = 'none'; 
      }
    });
  });
</script>