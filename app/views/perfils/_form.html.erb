<div class="neo-container" style="max-width: 600px; margin: 0 auto; padding: 30px;">
  <h2 class="neo-title"><%= @perfil.new_record? ? 'Nuevo Perfil' : 'Editar Perfil' %></h2>

  <%= form_with(model: @perfil, local: true, style: "text-align: left; margin-top: 30px;") do |form| %>
    
    <% if @perfil.errors.any? %>
      <div class="error-msg" style="display: block; color: #ff4757; margin-bottom: 20px;">
        <ul style="margin: 0; padding-left: 20px;">
          <% @perfil.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 25px;">
      <%= form.label :strNombre_Perfil, "Nombre del Perfil *", class: "neo-subtitle", style: "display: block; font-weight: bold; margin-bottom: 10px;" %>
      <%= form.text_field :strNombre_Perfil, class: "neo-input valida-nombre", required: true, minlength: "3" %>
    </div>

    <div style="margin-bottom: 30px; display: flex; align-items: center; gap: 10px;">
      <%= form.check_box :bitAdministrador, style: "width: 20px; height: 20px;" %>
      <%= form.label :bitAdministrador, "¿Es Administrador Total?", class: "neo-subtitle", style: "margin: 0; font-weight: bold;" %>
    </div>

    <div style="display: flex; gap: 15px; margin-top: 30px;">
      <%= form.submit "Guardar", class: "neo-button" %>
      <%= link_to "Cancelar", perfils_path, class: "neo-button", style: "text-decoration: none; display: flex; align-items: center; justify-content: center;" %>
    </div>
  <% end %>
</div>