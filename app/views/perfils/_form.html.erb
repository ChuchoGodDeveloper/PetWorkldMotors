<div class="neo-container" style="width: 100%; max-width: 700px; margin: 0 auto; padding: 40px;">

  <%= form_with(model: @perfil, local: true, html: { id: "perfil-form" }) do |form| %>
    
    <% if @perfil.errors.any? %>
      <div style="margin-bottom: 30px; padding: 20px; border-radius: 15px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: var(--danger);">
        <h2 style="margin-top: 0; font-size: 1.1rem;"><%= pluralize(@perfil.errors.count, "error") %> impidieron guardar este perfil:</h2>
        <ul style="margin-bottom: 0;">
          <% @perfil.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 25px;">
      <label class="neo-subtitle" style="display: block; margin-bottom: 10px; font-weight: bold; color: var(--text-primary);">Nombre del Perfil</label>
      <%= form.text_field :strNombre_Perfil, class: "neo-input", style: "width: 100%; box-sizing: border-box;", placeholder: "Ej. Administrador, Vendedor...", required: true %>
    </div>

    <div style="margin-bottom: 30px;">
      <label style="display: flex; align-items: center; gap: 10px; font-weight: bold; cursor: pointer; color: var(--text-primary);">
        <%= form.check_box :bitAdministrador, style: "width: 20px; height: 20px; accent-color: var(--accent);" %>
        ¿Este perfil tiene privilegios de Administrador?
      </label>
    </div>

    <div style="text-align: right; margin-top: 30px; display: flex; justify-content: flex-end; gap: 15px;">
      <%= link_to 'Cancelar', perfils_path, class: "neo-button", style: "padding: 10px 20px; text-decoration: none; width: auto; background: transparent; border: 1px solid var(--bento-border); color: var(--text-secondary);" %>
      <%= form.submit "Guardar Perfil", class: "neo-button", style: "padding: 10px 20px; cursor: pointer; border: none; width: auto; color: var(--accent);" %>
    </div>

  <% end %>
</div>