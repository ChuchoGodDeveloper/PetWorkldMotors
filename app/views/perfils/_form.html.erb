<div class="neo-container" style="width: 100%; max-width: 700px; margin: 0 auto; padding: 40px; background-color: #e0e5ec; border-radius: 20px; box-shadow: 20px 20px 60px #bebebe, -20px -20px 60px #ffffff;">

  <%# Cambiamos @usuario por @perfil %>
  <%= form_with(model: @perfil, local: true, html: { id: "perfil-form" }) do |form| %>
    
    <%# Cambiamos @usuario.errors por @perfil.errors %>
    <% if @perfil.errors.any? %>
      <div class="neo-alert-error" style="margin-bottom: 30px; padding: 20px; border-radius: 15px; background: #e0e5ec; box-shadow: inset 4px 4px 8px #babecc, inset -4px -4px 8px #ffffff; color: #e74c3c;">
        <h2 style="margin-top: 0; font-size: 1.1rem;"><%= pluralize(@perfil.errors.count, "error") %> impidieron guardar este perfil:</h2>
        <ul style="margin-bottom: 0;">
          <% @perfil.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div style="margin-bottom: 25px;">
      <label class="neo-subtitle" style="display: block; margin-bottom: 10px; font-weight: bold;">Nombre del Perfil</label>
      <%= form.text_field :strNombre_Perfil, class: "neo-input", style: "width: 100%; box-sizing: border-box;", placeholder: "Ej. Administrador, Vendedor...", required: true %>
    </div>

    <div style="margin-bottom: 30px;">
      <label style="display: flex; align-items: center; gap: 10px; font-weight: bold; cursor: pointer; color: #4a4a4a;">
        <%= form.check_box :bitAdministrador, class: "neo-checkbox", style: "width: 20px; height: 20px;" %>
        ¿Este perfil tiene privilegios de Administrador?
      </label>
    </div>

    <div style="text-align: right; margin-top: 30px; display: flex; justify-content: flex-end; gap: 15px;">
      <%= link_to 'Cancelar', perfils_path, class: "neo-button", style: "padding: 10px 20px; text-decoration: none;" %>
      <%= form.submit "Guardar Perfil", class: "neo-button", style: "padding: 10px 20px; cursor: pointer; border: none; font-family: inherit; font-size: inherit; color: #2e8b57;" %>
    </div>

  <% end %>
</div>