<div class="neo-container">
  
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
    <h2 class="neo-title" style="margin: 0;">Gestión de Usuarios</h2>
    
    <%# Validación para el botón de Agregar %>
    <% if tiene_permiso?('Usuarios', :bitAgregar) %>
      <%= link_to 'Nuevo Usuario', new_usuario_path, class: "neo-button", style: "width: auto; padding: 10px 20px; text-decoration: none;" %>
    <% end %>
  </div>

  <div style="margin-bottom: 30px; text-align: left;">
    <label class="neo-subtitle" style="display: block; margin-bottom: 10px; font-weight: bold;">BUSCAR POR USUARIO</label>
    <input type="text" id="buscador-input" placeholder="🔍 Buscar por nombre, perfil o correo..." class="neo-input" style="margin: 0; width: 100%; max-width: 500px;" autocomplete="off">
  </div>

  <div style="overflow-x: auto;">
    <table style="width: 100%; border-collapse: collapse; text-align: left; min-width: 800px;">
      <thead>
        <tr style="border-bottom: 2px solid rgba(163,177,198,0.6);">
          <th style="padding: 15px 10px; color: #333;">IMAGEN</th>
          <th style="padding: 15px 10px; color: #333;">USUARIO</th>
          <th style="padding: 15px 10px; color: #333;">PERFIL</th>
          <th style="padding: 15px 10px; color: #333;">CORREO</th>
          <th style="padding: 15px 10px; color: #333;">CELULAR</th>
          <th style="padding: 15px 10px; text-align: center; color: #333;">ESTADO</th>
          <th style="padding: 15px 10px; text-align: center; color: #333;">ACCIONES</th>
        </tr>
      </thead>
      <tbody>
        <% @usuarios.each do |usuario| %>
          <tr class="fila-busqueda" data-search="<%= "#{usuario.strNombreUsuario} #{usuario.perfil&.strNombre_Perfil} #{usuario.strCorreo}".downcase %>" style="border-bottom: 1px solid rgba(163,177,198,0.3);">
            <td style="padding: 15px 10px; color: #666;">
              <% if usuario.imagen_usuario.attached? %>
                <%= image_tag usuario.imagen_usuario, style: "width: 40px; height: 40px; border-radius: 50%; object-fit: cover; box-shadow: 4px 4px 8px 0 rgba(163, 177, 198, 0.7), -4px -4px 8px 0 rgba(255, 255, 255, 0.8);" %>
              <% else %>
                <span style="font-size: 0.85rem; color: #999;">Sin Imagen</span>
              <% end %>
            </td>
            <td style="padding: 15px 10px; font-weight: bold; color: #4a4a4a;"><%= usuario.strNombreUsuario %></td>
            <td style="padding: 15px 10px; color: #666;"><%= usuario.perfil&.strNombre_Perfil %></td>
            <td style="padding: 15px 10px; color: #666;"><%= usuario.strCorreo %></td>
            <td style="padding: 15px 10px; color: #666;"><%= usuario.strNumeroCelular.present? ? usuario.strNumeroCelular : '-' %></td>
            <td style="padding: 15px 10px; text-align: center;">
              <span style="padding: 5px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: bold; <%= usuario.idEstado_Usuario == 1 ? 'color: #2e8b57; background: #e0e5ec; box-shadow: inset 3px 3px 6px rgba(163, 177, 198, 0.7), inset -3px -3px 6px rgba(255, 255, 255, 0.8);' : 'color: #7f8c8d;' %>">
                <%= usuario.idEstado_Usuario == 1 ? 'Activo' : 'Inactivo' %>
              </span>
            </td>
            <td style="padding: 15px 10px; text-align: center;">
              <div style="display: flex; gap: 10px; justify-content: center;">
                
                <%# Validación para el botón de Editar %>
                <% if tiene_permiso?('Usuarios', :bitEditar) %>
                  <%= link_to 'Editar', edit_usuario_path(usuario), class: "neo-button", style: "width: auto; padding: 8px 15px; text-decoration: none;" %>
                <% end %>

                <%# Validación para el botón de Eliminar %>
                <% if tiene_permiso?('Usuarios', :bitEliminar) %>
                  <%= button_to 'Eliminar', usuario_path(usuario), method: :delete, form: { data: { turbo_confirm: '¿Estás seguro?' } }, class: "neo-button", style: "width: auto; padding: 8px 15px; color: #ff4757;" %>
                <% end %>

              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div style="margin-top: 20px;">
    <%= paginate @usuarios if defined?(paginate) %>
  </div>
</div>

<script>
  document.getElementById('buscador-input').addEventListener('input', function (e) {
    const term = e.target.value.toLowerCase();
    const rows = document.querySelectorAll('.fila-busqueda');

    rows.forEach(row => {
      // Tomamos la data que guardamos combinada (nombre + perfil + correo)
      const searchData = row.getAttribute('data-search') || '';
      if (searchData.includes(term)) {
        row.style.display = ''; 
      } else {
        row.style.display = 'none'; 
      }
    });
  });
</script>