<!DOCTYPE html>
<html>
<head>
  <title>Página no encontrada</title>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
</head>
<body style="display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0;">
  <div class="neo-container" style="max-width: 400px;">
    <div class="neo-title" style="font-size: 60px; color: var(--danger);">404</div>
    <div class="neo-subtitle" style="font-size: 18px;">Oops! Página no encontrada</div>
    <p style="color: var(--text-secondary); margin-bottom: 30px;">La ruta a la que intentas acceder no existe en PetWorld Motors.</p>
    <button class="neo-button" onclick="window.location.href='/principal'">Volver al Inicio</button>
  </div>
</body>
</html>